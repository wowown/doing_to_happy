<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>训练记录</title>
<meta name="theme-color" content="#0f1115" />
<style>
  /* 样式全写在这里，不引外部字体和 CSS 库：断网也能正常显示。 */
  :root {
    --bg: #0f1115;
    --card: #171a21;
    --card-2: #1e222b;
    --line: #262b36;
    --text: #e6e9ef;
    --muted: #8b93a7;
    --accent: #4ade80;
    --accent-dim: #16351f;
    --danger: #f87171;
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body { margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--text);
    font: 15px/1.5 -apple-system, "Segoe UI", "Microsoft YaHei", "PingFang SC", sans-serif;
    padding: 0 env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
  }
  .wrap { max-width: 560px; margin: 0 auto; padding: 18px 14px 40px; }
  h1 { font-size: 20px; margin: 0 0 2px; letter-spacing: .5px; }
  h2 { font-size: 15px; margin: 0 0 10px; color: var(--text); font-weight: 600; }
  .sub { color: var(--muted); font-size: 12.5px; margin-bottom: 16px; }
  .card {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 14px;
    margin-bottom: 14px;
  }
  .stats { display: flex; gap: 8px; margin-bottom: 14px; }
  .stat { flex: 1; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 10px 8px; text-align: center; }
  .stat b { display: block; font-size: 18px; font-variant-numeric: tabular-nums; }
  .stat span { color: var(--muted); font-size: 11.5px; }
  label.field { display: block; color: var(--muted); font-size: 12.5px; margin-bottom: 6px; }
  input, select, button, textarea { font: inherit; color: inherit; }
  input[type="date"], input[type="text"], input[type="number"], select, textarea {
    width: 100%;
    background: var(--card-2);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 9px 10px;
    outline: none;
  }
  input:focus, select:focus, textarea:focus { border-color: #3a4252; }
  input[type="number"] { -moz-appearance: textfield; }
  input[type="number"]::-webkit-outer-spin-button,
  input[type="number"]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  button {
    background: var(--card-2);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 9px 12px;
    cursor: pointer;
  }
  button:active { transform: translateY(1px); }
  button.primary { background: var(--accent); color: #06240f; border-color: var(--accent); font-weight: 600; }
  button.ghost { background: transparent; }
  button.mini { padding: 5px 9px; font-size: 13px; border-radius: 8px; }
  button.del { color: var(--danger); background: transparent; border-color: transparent; padding: 4px 8px; }
  .row { display: flex; gap: 8px; align-items: center; }
  .row > * { min-width: 0; }
  .grow { flex: 1; }
  /* 动作卡片 */
  .entry { border-top: 1px solid var(--line); padding-top: 12px; margin-top: 12px; }
  .entry:first-child { border-top: 0; padding-top: 0; margin-top: 0; }
  .entry-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
  .entry-name { font-weight: 600; }
  .hint { color: var(--muted); font-size: 12px; margin-bottom: 8px; }
  .hint b { color: var(--accent); font-weight: 600; }
  .sets { display: flex; flex-direction: column; gap: 6px; }
  .set-row { display: flex; gap: 6px; align-items: center; }
  .set-row .idx { color: var(--muted); font-size: 12px; width: 26px; text-align: right; font-variant-numeric: tabular-nums; }
  .set-row input { text-align: center; }
  .unit { color: var(--muted); font-size: 12px; width: 14px; }
  .sets-empty { color: var(--muted); font-size: 12.5px; padding: 4px 0; }
  /* 历史 */
  .hist-item { border-top: 1px solid var(--line); padding: 10px 0; }
  .hist-item:first-child { border-top: 0; }
  .hist-top { display: flex; justify-content: space-between; gap: 8px; font-size: 13px; }
  .hist-date { color: var(--muted); font-variant-numeric: tabular-nums; }
  .hist-body { color: var(--text); font-size: 13px; margin-top: 3px; word-break: break-word; }
  .hist-note { color: var(--muted); font-size: 12px; margin-top: 3px; }
  .empty { color: var(--muted); font-size: 13px; padding: 6px 0; }
  canvas { width: 100%; height: 150px; display: block; }
  .pr { color: var(--muted); font-size: 12.5px; margin-top: 8px; }
  .pr b { color: var(--accent); }
  .demo-banner { background: #2a2312; border: 1px solid #4a3c1a; color: #f5c96b; font-size: 12.5px; border-radius: 10px; padding: 8px 10px; margin-bottom: 14px; }
</style>
</head>
<body>
<div class="wrap">
  <h1>训练记录</h1>
  <div class="sub">自己用的重量体重记录 · 数据只存在这台设备的浏览器里</div>

  <div id="demo-banner" class="demo-banner" hidden>
    示例数据预览模式（?demo=1）。这些不是真记录，也不会被保存。
  </div>

  <div class="stats">
    <div class="stat"><b id="stat-sessions">0</b><span>训练次数</span></div>
    <div class="stat"><b id="stat-volume">0</b><span>总容量 kg</span></div>
    <div class="stat"><b id="stat-exercises">0</b><span>练过动作</span></div>
  </div>

  <!-- 记录一次训练 -->
  <section class="card">
    <h2>今天练了</h2>
    <label class="field" for="date">日期</label>
    <input type="date" id="date" />
    <div id="entries" style="margin-top: 14px;"></div>

    <div class="row" style="margin-top: 14px;">
      <select id="exercise-select" class="grow" aria-label="选择动作"></select>
      <button id="add-exercise" class="mini">+ 加动作</button>
    </div>
    <div class="row" style="margin-top: 8px;">
      <input type="text" id="custom-exercise" class="grow" placeholder="没有的动作用这里，输入名字回车" />
      <button id="add-custom" class="mini">添加</button>
    </div>

    <label class="field" for="note" style="margin-top: 14px;">备注（可选）</label>
    <input type="text" id="note" placeholder="比如 状态不错 / 手腕有点紧" />

    <button id="save" class="primary" style="width: 100%; margin-top: 14px; padding: 12px;">保存这次训练</button>
  </section>

  <!-- 进步曲线 -->
  <section class="card">
    <h2>进步曲线</h2>
    <select id="progress-exercise" aria-label="选择动作"></select>
    <canvas id="chart" width="520" height="150"></canvas>
    <div class="pr" id="pr"></div>
  </section>

  <!-- 历史 -->
  <section class="card">
    <h2>历史记录</h2>
    <div id="history"></div>
  </section>

  <!-- 数据 -->
  <section class="card">
    <h2>备份</h2>
    <div class="row">
      <button id="export" class="grow">导出 JSON</button>
      <button id="import-btn" class="grow">导入 JSON</button>
    </div>
    <input type="file" id="import-file" accept="application/json,.json" hidden />
    <div class="sub" style="margin: 10px 0 0;">换电脑或清缓存前导出一份。导入是合并，不会覆盖已有记录。</div>
  </section>
</div>

<script src="logic.js"></script>
<script src="app.js"></script>
</body>
</html>
